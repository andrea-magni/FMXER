unit FMXER.Registration;

// FMXER has no components: this unit, in the design-time package dclFMXERPackage,
// only adds FMXER to the splash screen and to the About box of the IDE.
// FMXERSPLASH48PNG (media\FMXERSplash48.png) is an RcItem resource of the package
// (dclFMXERPackage.dres, generated by the build).

interface

procedure Register;

implementation

uses
  Winapi.Windows, System.SysUtils, System.Classes, Vcl.Graphics, Vcl.Imaging.pngimage,
  ToolsAPI;

const
  RsAboutTitle = 'FMXER';
  RsAboutDescription = 'FMXER - https://github.com/andrea-magni/FMXER' + sLineBreak +
    'Flutter-inspired framework to build FireMonkey user interfaces in code, built on TFrameStand.' + sLineBreak +
    'Documentation: https://andrea-magni.github.io/FMXER/';
  RsAboutLicense = 'MPL-2.0 (Free/Opensource)';

var
  AboutBoxServices: IOTAAboutBoxServices = nil;
  AboutBoxIndex: Integer = 0;

// the version of the package (FileVersion of its version info): 1.5.1, or 1.5 when
// the release number is 0
function GetFMXERVersion: string;
var
  LFileName: string;
  LSize, LHandle, LLen: DWORD;
  LBuffer: TBytes;
  LInfo: PVSFixedFileInfo;
begin
  Result := '';
  LFileName := GetModuleName(HInstance);
  LSize := GetFileVersionInfoSize(PChar(LFileName), LHandle);
  if LSize = 0 then
    Exit;
  SetLength(LBuffer, LSize);
  if GetFileVersionInfo(PChar(LFileName), 0, LSize, LBuffer)
    and VerQueryValue(LBuffer, '\', Pointer(LInfo), LLen) then
  begin
    Result := Format('%d.%d', [HiWord(LInfo.dwFileVersionMS), LoWord(LInfo.dwFileVersionMS)]);
    if HiWord(LInfo.dwFileVersionLS) <> 0 then
      Result := Result + '.' + IntToStr(HiWord(LInfo.dwFileVersionLS));
  end;
end;

function GetTitle: string;
begin
  Result := Trim(RsAboutTitle + ' ' + GetFMXERVersion);
end;

function CreateLogoBitmap: Vcl.Graphics.TBitmap;
var
  LPngImage: TPngImage;
  LResStream: TResourceStream;
begin
  Result := Vcl.Graphics.TBitmap.Create;
  LPngImage := TPngImage.Create;
  try
    LResStream := TResourceStream.Create(HInstance, 'FMXERSPLASH48PNG', RT_RCDATA);
    try
      LPngImage.LoadFromStream(LResStream);
    finally
      LResStream.Free;
    end;
    Result.Assign(LPngImage);
  finally
    LPngImage.Free;
  end;
end;

procedure RegisterWithSplashScreen;
var
  LBitmap: Vcl.Graphics.TBitmap;
begin
  if not Assigned(SplashScreenServices) then
    Exit;
  LBitmap := CreateLogoBitmap;
  try
    SplashScreenServices.AddPluginBitmap(GetTitle, LBitmap.Handle, False, RsAboutLicense);
  finally
    LBitmap.Free;
  end;
end;

procedure RegisterAboutBox;
var
  LBitmap: Vcl.Graphics.TBitmap;
begin
  if not Supports(BorlandIDEServices, IOTAAboutBoxServices, AboutBoxServices) then
    Exit;
  LBitmap := CreateLogoBitmap;
  try
    AboutBoxIndex := AboutBoxServices.AddPluginInfo(GetTitle, RsAboutDescription,
      LBitmap.Handle, False, RsAboutLicense);
  finally
    LBitmap.Free;
  end;
end;

procedure UnregisterAboutBox;
begin
  if (AboutBoxIndex <> 0) and Assigned(AboutBoxServices) then
    AboutBoxServices.RemovePluginInfo(AboutBoxIndex);
  AboutBoxIndex := 0;
  AboutBoxServices := nil;
end;

procedure Register;
begin
  RegisterWithSplashScreen;
end;

initialization
  RegisterAboutBox;

finalization
  UnregisterAboutBox;

end.
