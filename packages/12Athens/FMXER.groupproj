    </Target>
    <Target Name="dclFMXERPackage:Make">
        <MSBuild Projects="dclFMXERPackage.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FMXERPackage;FMXERQRCodePackage;dclFMXERPackage"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FMXERPackage:Clean;FMXERQRCodePackage:Clean;dclFMXERPackage:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FMXERPackage:Make;FMXERQRCodePackage:Make;dclFMXERPackage:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
    <ItemGroup Condition="'$(BuildGroup)'=='ALL'">
        <BuildGroupProject Include="FMXERPackage.dproj">
            <ProjectGuid>{6C0E5C2B-0F3D-4C55-9A3E-6B1C2F0A1201}</ProjectGuid>
            <Configurations>Release</Configurations>
