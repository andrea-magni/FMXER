<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6C0E5C2B-0F3D-4C55-9A3E-6B1C2F0A1203}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FMXERPackage.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FMXERQRCodePackage.dproj">
            <Dependencies>FMXERPackage.dproj</Dependencies>
        </Projects>
        <Projects Include="dclFMXERPackage.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="FMXERPackage">
        <MSBuild Projects="FMXERPackage.dproj"/>
    </Target>
    <Target Name="FMXERPackage:Clean">
        <MSBuild Projects="FMXERPackage.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMXERPackage:Make">
        <MSBuild Projects="FMXERPackage.dproj" Targets="Make"/>
    </Target>
    <Target Name="FMXERQRCodePackage" DependsOnTargets="FMXERPackage">
