        <VerInfo_Release>0</VerInfo_Release>
        <VerInfo_Keys>CompanyName=Andrea Magni;FileDescription=FMXER QR code Runtime Package;FileVersion=1.10.0.0;InternalName=FMXERQRCodePackage;LegalCopyright=Andrea Magni;LegalTrademarks=;OriginalFilename=;ProductName=FMXER;ProductVersion=1.10.0.0;Comments=https://github.com/andrea-magni/FMXER</VerInfo_Keys>
